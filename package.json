{
  "name": "youtube-player-firefox",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "check": "npm run check:syntax && npm test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "profile:memory": "node --expose-gc scripts/profile-memory.mjs",
    "build": "sh scripts/build-release.sh",
    "lint:firefox": "npx --yes web-ext@10 lint --source-dir build/latest --self-hosted",
    "sign:firefox": "node scripts/sign-firefox.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
